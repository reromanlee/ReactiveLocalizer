# The button that adds a coin to the counter above it.
AddCoin = Add a coin

# How many coins the player has, counting up as the button is pressed.
Coins = You have {coins, plural, =0 {no coins} one {# coin} other {# coins}}.

# Greets whoever opened the sample.
Greeting = Hello! Pick a language on the left, and every text here follows at once.

# Explains where these texts come from.
Hint = These texts live in the .lang files next to this sample. Edit one, save it, and enter Play Mode again.

# The heading at the top of the screen.
Title = ReactiveLocalizer Quick Start
