<Project Sdk="Microsoft.NET.Sdk">
  <!-- The package's pure authoring logic, built outside Unity like the core. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>reromanlee.ReactiveLocalizer.Authoring</AssemblyName>
    <RootNamespace>reromanlee.ReactiveLocalizer.Authoring</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PackageRoot)Authoring\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>
</Project>
